from collections.abc import Sequence
from types import TracebackType
from typing import Self

from .results import BatchResult
from .simulation import GameLike, StrategyLike

class Timer:
    def __init__(self) -> None: ...
    def start(self) -> None: ...
    def stop(self) -> None: ...
    @property
    def elapsed_seconds(self) -> float: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *args: object) -> None: ...

class MemoryStats:
    @property
    def allocation_count(self) -> int: ...
    @property
    def deallocation_count(self) -> int: ...
    @property
    def bytes_allocated(self) -> int: ...
    @property
    def bytes_freed(self) -> int: ...
    @property
    def live_bytes(self) -> int: ...
    @property
    def peak_live_bytes(self) -> int: ...

class BenchmarkResult:
    @property
    def outcome(self) -> BatchResult: ...
    @property
    def elapsed_seconds(self) -> float: ...
    @property
    def matches_per_second(self) -> float: ...
    @property
    def decisions_per_second(self) -> float: ...
    @property
    def memory(self) -> MemoryStats | None: ...

def benchmark(game: GameLike, strategies: Sequence[StrategyLike], games: int = 1000, seed: int | None = None, memory: bool = False) -> BenchmarkResult: ...
